ARG ALIAS=biop/
ARG BASE_IMAGE=0.2.2
FROM biop/

USER root

#############################################################################
# install microsam
RUN conda create --name microsam --clone base \
    && source activate microsam \
    && pip install --upgrade pip \
    && pip install napari[all] \
    && conda install micro_sam \
    && conda clean --all -f -y


